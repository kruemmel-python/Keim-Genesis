modul kurs.v75.result

funktion lade_punkt(name ist text) gibt result<ganzzahl, text>:
    wenn name == "":
        rueckgabe error("Name fehlt")
    sonst:
        rueckgabe ok(42)

funktion main() gibt ganzzahl:
    speicher r ist result<ganzzahl, text> setzt lade_punkt("Ada")
    match r:
        fall ok(wert):
            rueckgabe wert
        fall error(err):
            rueckgabe 0
