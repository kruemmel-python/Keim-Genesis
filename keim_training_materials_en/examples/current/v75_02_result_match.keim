modul schulung.v75.result

exportiere funktion main

funktion teile(a ist ganzzahl, b ist ganzzahl) gibt result<ganzzahl, text>:
    wenn b == 0:
        rueckgabe error("division durch null")
    sonst:
        rueckgabe ok(a / b)

funktion main() gibt ganzzahl:
    speicher r ist result<ganzzahl, text> setzt teile(84, 2)
    match r:
        fall ok(wert):
            rueckgabe wert
        fall error(meldung):
            rueckgabe 0
