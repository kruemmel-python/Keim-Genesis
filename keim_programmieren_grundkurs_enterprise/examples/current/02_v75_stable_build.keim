modul kurs.v75.stable

exportiere funktion main

funktion addiere(a ist ganzzahl, b ist ganzzahl) gibt ganzzahl:
    rueckgabe a + b

funktion main() gibt ganzzahl:
    speicher basis ist ganzzahl setzt 40
    speicher bonus ist ganzzahl setzt 2
    rueckgabe addiere(basis, bonus)

test "antwort ist 42":
    pruefe main() == 42
